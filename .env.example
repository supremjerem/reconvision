# Copy to .env and adjust. Never commit the resulting .env file.

# --- Storage -----------------------------------------------------------------
RECONVISION_DATA_DIR=./data
RECONVISION_SNAPSHOT_RETENTION_DAYS=30

# --- Recognition -------------------------------------------------------------
# Cosine similarity above which a face is considered a match. Do not guess this
# value: run `reconvision eval` and use the threshold it recommends.
RECONVISION_MATCH_THRESHOLD=0.42
RECONVISION_FACE_MODEL_PACK=buffalo_l
RECONVISION_MIN_FACE_PIXELS=80

# --- Camera credentials ------------------------------------------------------
# Referenced from cameras.yaml as ${LIVING_ROOM_STREAM_URL} so no URL or
# password ever lands in a versioned file.
LIVING_ROOM_STREAM_URL=rtsp://user:password@192.168.1.50:554/stream1

# --- Notifications -----------------------------------------------------------
RECONVISION_NTFY_URL=https://ntfy.sh
RECONVISION_NTFY_TOPIC=
RECONVISION_MQTT_HOST=
RECONVISION_MQTT_PORT=1883
RECONVISION_MQTT_USERNAME=
RECONVISION_MQTT_PASSWORD=
RECONVISION_WEBHOOK_URL=

# --- Observability -----------------------------------------------------------
# console for local development, otlp when shipping to Grafana/Tempo.
RECONVISION_TELEMETRY_EXPORTER=console
RECONVISION_OTLP_ENDPOINT=http://localhost:4318
RECONVISION_LOG_LEVEL=INFO
